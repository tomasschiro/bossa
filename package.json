{
  "name": "bossa-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed.ts",
    "test:auth": "node --env-file=.env.local scripts/auth-smoke.mjs",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "test:naipes": "node --env-file=.env.local scripts/naipes-smoke.mjs",
    "test:inventario": "node --env-file=.env.local scripts/inventario-smoke.mjs",
    "test:agenda": "node --import tsx scripts/agenda-dates.test.ts && node --env-file=.env.local scripts/agenda-smoke.mjs",
    "test:configuracion": "node --env-file=.env.local scripts/configuracion-smoke.mjs",
    "test:carnaval": "node --import tsx scripts/carnaval-dates.test.ts && node --env-file=.env.local scripts/carnaval-smoke.mjs",
    "test:naipes-plan": "node --import tsx scripts/naipes-plan.test.ts && node --env-file=.env.local scripts/naipes-plan-smoke.mjs"
  },
  "prisma": {
    "seed": "node --env-file=.env.local --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "prisma": "^6.12.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
